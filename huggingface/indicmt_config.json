{
  "name": "IndicMT",
  "format": [
    "ctranslate2",
    "opennmt-py"
  ],
  "requires": {
    "ctranslate2": {
      "ctranslate2": "4.8.2",
      "sentencepiece": "0.2.2"
    },
    "opennmt-py": {
      "torch": "2.2.0",
      "OpenNMT-py": "3.5.1",
      "sentencepiece": "0.2.2"
    }
  },
  "tokenizer": "indicMT.spm.model",
  "architecture": {
    "type": "transformer",
    "encoder_layers": 12,
    "decoder_layers": 12,
    "d_model": 512,
    "ffn_size": 2048,
    "attention_heads": 16,
    "parameters": 153807872,
    "vocabulary": "shared 128k SentencePiece unigram, tied embeddings"
  },
  "checkpoint": "12+12, combined 8:2 mined:human pre-training step 13600, then human-only fine-tune without replay step 1800",
  "variants": {
    "int8": {
      "path": "indicMT",
      "compute_type": "int8",
      "size_mb": 170.6,
      "recommended": true,
      "in22_gen_chrf++": {
        "en-xx": 47.16,
        "xx-en": 53.85
      }
    },
    "opennmt-py": {
      "path": "indicMT.pt",
      "format": "opennmt-py",
      "dtype": "float32",
      "size_mb": 2397.6,
      "recommended": false,
      "includes_optimizer_state": true,
      "in22_gen_chrf++": {
        "en-xx": 46.95,
        "xx-en": 53.69
      },
      "in22_conv_chrf++": {
        "en-xx": 42.97,
        "xx-en": 50.38
      }
    }
  },
  "source_format": {
    "template": "<{tgt}> {text}",
    "encode": "sp.encode(template, out_type=str) on the whole string, never tag + sp.encode(text)",
    "expected_prefix": [
      "▁",
      "<{tgt}>"
    ],
    "tag_names": "the target language"
  },
  "target_format": "SentencePiece pieces without a tag; detokenize with sp.decode",
  "decoding": {
    "beam_size": 5,
    "max_source_pieces_in_training": 200
  },
  "pivot": "Indic to Indic: translate to English (<en>) first, then to the target",
  "languages": {
